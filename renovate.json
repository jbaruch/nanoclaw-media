{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "Keep Python 3.14 runtime coverage on its supported minor while allowing patch updates.",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "python"
      ],
      "matchCurrentVersion": "/^3\\.14\\./",
      "allowedVersions": "/^3\\.14\\./"
    }
  ]
}
